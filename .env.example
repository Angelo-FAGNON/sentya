# Copier ce fichier en .env, puis remplir les valeurs. Ne jamais commiter .env.
# Générer un secret : openssl rand -base64 32

# --- Telegram ---
# Jeton donné par BotFather (voir README, "Créer le bot avec BotFather").
TELEGRAM_BOT_TOKEN=
# Chaîne aléatoire (16 à 256 caractères parmi A-Z a-z 0-9 _ -), vérifiée à chaque appel du webhook.
# Exemple : openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
# Nom d'utilisateur du bot, sans @ (lien t.me et QR code du site).
TELEGRAM_BOT_USERNAME=SentyaBot
# "polling" en local, "webhook" en production (la surcouche de production le force).
BOT_MODE=polling
# URL publique HTTPS du bot, obligatoire en mode webhook (ex. https://bot.sentya.example).
BOT_PUBLIC_URL=
# Port local exposé pour /health du bot.
BOT_PORT=8080

# --- Claude (raisonnement : compétences, CV, pistes, corrections) ---
# Clé de l'API Anthropic. Sans clé, le bot tourne en mode dégradé, sans IA (replis déterministes).
ANTHROPIC_API_KEY=
# Modèle Claude.
CLAUDE_MODEL=claude-opus-5-5
# Profondeur de réflexion : low, medium, high, xhigh ou max. "low" tient les 20 secondes des pistes.
CLAUDE_EFFORT=low

# --- Gemini (audio seulement : transcription des vocaux et réponses audio) ---
# Facultative : sans clé, le bot demande d'écrire au lieu d'envoyer un vocal.
GEMINI_API_KEY=
# Modèle qui transcrit les vocaux (entrée audio, sortie JSON structurée).
GEMINI_MODEL=gemini-3.8-flash
# Modèle de synthèse vocale (EF-14).
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# --- Base de données ---
# Mot de passe du PostgreSQL lancé par docker compose.
POSTGRES_PASSWORD=sentya
# Utilisée hors Docker (pnpm dev). Dans Docker, docker-compose.yml la remplace.
DATABASE_URL=postgresql://sentya:sentya@localhost:5432/sentya
# Base dédiée aux tests d'intégration (vidée à chaque test).
TEST_DATABASE_URL=postgresql://sentya:sentya@localhost:5432/sentya_test

# --- Web ---
APP_URL=http://localhost:3000
WEB_PORT=3000
# Secret Auth.js : openssl rand -base64 32
AUTH_SECRET=
# Auth.js derrière Docker ou un proxy inverse.
AUTH_TRUST_HOST=true
# Sel secret du hachage des identifiants (analyses) : openssl rand -base64 32
HASH_SALT=

# --- Premier administrateur (créé par le seed, double authentification à la 1re connexion) ---
ADMIN_EMAIL=admin@example.org
# 12 caractères minimum.
ADMIN_PASSWORD=

# --- Journaux ---
LOG_LEVEL=info

# --- Production (deploiement/docker-compose.prod.yml) ---
DOMAINE_WEB=
DOMAINE_BOT=
