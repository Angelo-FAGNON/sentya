# Copier ce fichier en .env, puis remplir les valeurs. Ne jamais commiter .env.

# --- Telegram ---
# Jeton donné par BotFather.
TELEGRAM_BOT_TOKEN=
# Chaîne aléatoire (1 à 256 caractères parmi A-Z a-z 0-9 _ -), vérifiée à chaque appel du webhook.
TELEGRAM_WEBHOOK_SECRET=
# Nom d'utilisateur du bot, sans @ (pour le lien t.me et le QR code).
TELEGRAM_BOT_USERNAME=SentyaBot
# "polling" en développement, "webhook" en production.
BOT_MODE=polling

# --- Gemini ---
GEMINI_API_KEY=
# Modèle stable avec entrée audio et PDF et sortie JSON structurée.
GEMINI_MODEL=gemini-3.8-flash
# Modèle de synthèse vocale (EF-14).
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# --- Base de données ---
DATABASE_URL=postgresql://sentya:sentya@localhost:5432/sentya

# --- Web ---
APP_URL=http://localhost:3000
# Secret Auth.js : openssl rand -base64 32
AUTH_SECRET=
# Sel secret du hachage des identifiants (analyses) : openssl rand -base64 32
HASH_SALT=

# --- Premier administrateur (créé par le seed) ---
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=
