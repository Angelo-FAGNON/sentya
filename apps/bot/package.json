{
  "name": "@sentya/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.10.0",
    "@google/genai": "3.6.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentya/core": "workspace:*",
    "@sentya/db": "workspace:*",
    "grammy": "^1.46.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3",
    "pg-boss": "^12.38.2",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pdfkit": "^0.17.3",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "^5.1.1"
  }
}
